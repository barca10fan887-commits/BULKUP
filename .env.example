# ---------- Frontend (exposed to the browser; never put secrets here) ----------
# Supabase project URL and anon/public key. Leave blank to run in on-device "local mode".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Open Food Facts base URL (use a regional mirror like https://au.openfoodfacts.org if you prefer).
VITE_OFF_BASE_URL=https://world.openfoodfacts.org

# ---------- Server only (never exposed to the browser) ----------
PORT=8787
# Claude API key for the AI coach and food photo scanner. Leave blank to use the basic fallback coach.
ANTHROPIC_API_KEY=
# Optional model override.
ANTHROPIC_MODEL=claude-opus-5-5
# Same Supabase project, used by the server to verify the signed-in user.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: ONLY used server-side for "Delete account". Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
# Without Supabase, set an access code to protect the AI endpoints on a public deployment.
# Users enter it once in Settings > Privacy.
BULKUP_ACCESS_CODE=
